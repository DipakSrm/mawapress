# Copy to .env. All settings use the MAWA_ prefix. Every setting the app reads is listed here.

# "dev" allows the built-in JWT secret and local storage without warnings; any other value enforces a strong
# secret, secure cookies, and logs a startup warning for MAWA_TRUST_PROXY=false and MAWA_STORAGE=local.
MAWA_ENV=dev
MAWA_DATABASE_URL=postgresql+asyncpg://mawa:mawa@localhost:5432/mawapress
MAWA_REDIS_URL=redis://localhost:6379/0

# Must be at least 32 random characters outside dev (e.g. `openssl rand -hex 32`).
MAWA_JWT_SECRET=replace-me-with-32-or-more-random-characters
MAWA_JWT_ACCESS_MINUTES=15
# Canonical public origin: used in canonical URLs, sitemaps, RSS and CDN purge URLs (no trailing slash needed).
MAWA_SITE_URL=https://mawapress.com

# Refresh-token session (httpOnly cookie `mawa_refresh`, CSRF cookie `mawa_csrf`).
MAWA_REFRESH_DAYS=14
# Secure cookies need https; set to false only for plain-http local development (refused outside dev).
MAWA_COOKIE_SECURE=false

# Client IP (rate limits, view dedup). Only set MAWA_TRUST_PROXY=true behind a proxy you control.
# Then the client IP is MAWA_CLIENT_IP_HEADER if it holds a valid IP, else the RIGHT-most valid
# X-Forwarded-For entry (the hop your proxy appended), else the socket peer. See README "Behind Cloudflare and Nginx".
MAWA_TRUST_PROXY=false
MAWA_CLIENT_IP_HEADER=CF-Connecting-IP
# Fixed window for the login (5 per IP+email, 20 per IP) and search (30 per IP) limits; view counting allows 60 per IP.
# Failed logins per account (hashed email) are separately capped at 20 per hour.
MAWA_RATE_LIMIT_WINDOW_SECONDS=60

# Daily view-dedup salt secret. Empty = derived from MAWA_JWT_SECRET.
MAWA_STATS_SALT=

# Media storage: "local" (dev/tests; files under MAWA_MEDIA_LOCAL_DIR, served by the API at /media) or "s3"
# (Cloudflare R2 or any S3-compatible bucket; needs all of the s3 settings below plus MAWA_MEDIA_BASE_URL).
MAWA_STORAGE=local
MAWA_MEDIA_LOCAL_DIR=.media
# Public origin of the bucket/CDN that serves media. Empty = same-origin relative URLs (local storage).
MAWA_MEDIA_BASE_URL=
MAWA_S3_ENDPOINT=
MAWA_S3_BUCKET=
MAWA_S3_ACCESS_KEY=
MAWA_S3_SECRET_KEY=

# Outbox worker (see README "Background worker"). Each integration is skipped while unset.
# Next.js on-demand revalidation route (POST {tags, paths}, header x-revalidate-secret) and its shared secret.
MAWA_REVALIDATE_URL=
MAWA_REVALIDATE_SECRET=
# Cloudflare CDN purge: zone id and an API token with Cache Purge permission.
MAWA_CF_ZONE_ID=
MAWA_CF_API_TOKEN=
