# Where the Next.js server forwards same-origin /api and /media calls (dev / no reverse proxy).
BACKEND_URL=http://127.0.0.1:8000

# Public site origin (no trailing slash), used for "Copy public link", media URLs and the SEO preview.
# Falls back to the origin the admin is open on when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
